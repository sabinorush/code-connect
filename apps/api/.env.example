PORT=3000

# Secret used to sign/verify JWTs. Generate a real value for local/prod use,
# e.g.: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Access token lifetime, in seconds.
JWT_EXPIRES_IN=3600

# Origins allowed to call this API via CORS (comma-separated). Includes
# 5174 because Vite auto-increments the port when 5173 is already taken
# by another running instance.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Postgres connection string. Matches the defaults in the root
# docker-compose.yml — `docker compose up -d` is enough to make this work.
DATABASE_URL=postgresql://code_connect:code_connect@localhost:5432/code_connect
