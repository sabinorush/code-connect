PORT=3000

# Secret used to sign/verify JWTs. Generate a real value for local/prod use,
# e.g.: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Access token lifetime, in seconds.
JWT_EXPIRES_IN=3600

# Origin allowed to call this API via CORS (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173
